// ==============================================================================
//  Wisp Shell — Niri Compositor Configuration
//  https://github.com/physteorts/wisp-shell
// ==============================================================================

spawn-sh-at-startup "quickshell -p ~/.config/quickshell/wisp-shell"
prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

layout {
    gaps 10
    background-color "transparent"

    focus-ring {
        off
        active-color "#85d6c0"
        inactive-color "#3f4945"
    }

    border {
        off
        active-color "#85d6c0"
        inactive-color "#3f4945"
    }
}

layer-rule {
    match namespace="^quickshell-wallpaper$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^wisp-lockscreen$"
    block-out-from "screen-capture"
}

overview {
    workspace-shadow {
        off
    }
}

recent-windows {
    highlight {
        active-color "#85d6c0"
        urgent-color "#ffb4ab"
        corner-radius 12
    }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    open-maximized true
}

binds {
    Mod+S hotkey-overlay-title="Toggle Wisp Shell Settings" {
        spawn-sh "quickshell -c wisp-shell ipc call settings toggle"
    }

    Mod+N hotkey-overlay-title="Toggle Notifications" {
        spawn-sh "quickshell -c wisp-shell ipc call notifications toggle"
    }

    Mod+T hotkey-overlay-title="Open a Terminal: ghostty" {
        spawn "ghostty"
    }
}
